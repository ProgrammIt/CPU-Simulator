{
  "name": "ihme-core-simulator",
  "productName": "Ihme-Core Simulator",
  "version": "1.1.0",
  "description": "A simple graphical simulator for teaching students the basics of computer architecture and virtualization.",
  "main": ".webpack/main",
  "scripts": {
    "test": "jest",
    "start": "electron-forge start -- --ozone-platform=x11",
    "profile": "electron --inspect=9229 --ozone-platform=x11 .webpack/main",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "lint": "eslint",
    "docs": "typedoc"
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/?(*.)+(spec|test).+(ts|tsx|js)"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "moduleNameMapper": {
      "\\.(png|jpg|jpeg|gif|svg)$": "<rootDir>/src/tests/fileMock.ts"
    }
  },
  "keywords": [],
  "author": "Erik Burmester",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-webpack": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "9.39.4",
    "@jest/globals": "30.4.1",
    "@types/jest": "30.0.0",
    "@vercel/webpack-asset-relocator-loader": "1.10.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "electron": "43.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-import": "2.32.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "jest": "30.4.2",
    "style-loader": "4.0.0",
    "ts-jest": "29.4.11",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "typedoc": "0.28.20",
    "typedoc-material-theme": "1.4.1",
    "typedoc-plugin-markdown": "4.12.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.64.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1"
  }
}
